    "core-js": "^3.50.0",
    "date-fns": "^4.4.0",
    "dompurify": "3.4.14",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.6.0",
    "posthog-js": "^1.418.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "resend": "^6.21.0",
    "serverless-http": "^4.0.0",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "convex-test": "^0.0.56",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.7",
    "wrangler": "4.122.0"
  },
  "overrides": {
    "js-cookie": "3.0.7",
    "@xmldom/xmldom": "0.8.13",
    "dompurify": "3.4.14",
    "undici": "^7.29.0"
  }
}
