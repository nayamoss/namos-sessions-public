{
  "name": "namos-sessions-public",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "cloudflare": {
    "bindings": {
      "VITE_CONVEX_URL": {
        "description": "Public URL of an already-deployed Convex production deployment."
      },
      "VITE_CLERK_PUBLISHABLE_KEY": {
        "description": "Public publishable key from your Clerk production application."
      },
      "VITE_GA_MEASUREMENT_ID": {
        "description": "GA4 measurement ID. Loaded only after visitor analytics consent."
      },
      "VITE_POSTHOG_KEY": {
        "description": "PostHog US project key. Loaded only after visitor analytics consent."
      },
      "VITE_POSTHOG_HOST": {
        "description": "PostHog API host, normally https://us.i.posthog.com."
      },
      "VITE_ENABLE_ANALYTICS": {
        "description": "Leave false outside production unless intentionally validating analytics."
      },
      "VITE_MARKETING_SITE_URL": {
        "description": "Public marketing site base URL used for privacy links."
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosted": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc -p convex/tsconfig.json --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc -p packages/sdk/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit && tsc -p packages/mcp/tsconfig.json --noEmit",
    "check:worker-types": "wrangler types worker-configuration.d.ts --env-interface Env --env-file wrangler.types.env --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:railway": "serve --single --listen tcp://0.0.0.0:$PORT dist",
    "convex:deploy": "convex dev --once && node scripts/check-convex-auth.mjs --fix",
    "convex:check-auth": "node scripts/check-convex-auth.mjs",
    "deploy": "node scripts/check-convex-auth.mjs && node scripts/deploy-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "preview:cloudflare": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:sdk": "vitest run --configLoader runner packages/sdk",
    "check:agent-no-stubs": "node scripts/check-agent-no-stubs.mjs",
    "validate:config": "node scripts/lib/validate-wrangler-config.mjs",
    "check": "npm run check:worker-types && npm run typecheck && npm run check:agent-no-stubs && npm run test && npm run build",
    "test:watch": "vitest",
    "prepare": "husky",
    "seed:demo": "npx convex run seed:demo",
    "eval:agent:live": "node scripts/agent-live-eval.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.45",
    "@aws-sdk/client-sesv2": "^3.1115.0",
    "@clerk/backend": "^3.16.10",
    "@clerk/clerk-react": "^5.61.9",
    "@convex-dev/agent": "0.7.1",
    "@convex-dev/workflow": "0.4.6",
    "@elevenlabs/react": "1.13.0",
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/papaparse": "^5.5.2",
    "@types/pdfjs-dist": "^2.10.378",
    "ai": "7.0.73",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.3",
