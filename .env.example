# Client-visible configuration
VITE_DATA_BACKEND=convex
VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_CONVEX_SITE_URL=https://your-project.convex.site
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Optional, consent-gated analytics. These are public browser identifiers; do not put secrets here.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_POSTHOG_KEY=phc_your_posthog_public_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Leave disabled for development unless intentionally validating analytics.
VITE_ENABLE_ANALYTICS=false
VITE_MARKETING_SITE_URL=https://your-marketing-site.example
# Cloudflare's always-pass test site key is safe for local development only. Production builds
# must receive the real public site key; `scripts/deploy-cloudflare.mjs` rejects this test value.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Pages Function only. Never prefix these with VITE_.
AIRTABLE_API_KEY=your-airtable-api-key
AIRTABLE_BASE_ID=your-airtable-base-id
CLERK_SECRET_KEY=your-clerk-secret-key
# Use CLERK_JWT_KEY instead of the secret key only for networkless verification.
CLERK_JWT_KEY=your-clerk-jwt-public-key
# Optional comma-separated allowed browser origins for Clerk token verification.
CLERK_AUTHORIZED_PARTIES=https://your-app.example.com
# Used by the Cloudflare Pages Function to check the caller against the organizers table.
CONVEX_URL=https://your-project.convex.cloud

# Server-only Netlify email delivery. Use a verified sender; never prefix with VITE_.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=notifications@example.com
# Shared only between the Convex deployment and Netlify confirmation function. Never expose it
# to Vite/browser variables. Generate a long random value per deployment.
CONFIRMATION_DELIVERY_SECRET=replace-with-a-long-random-secret
# Canonical deployed frontend origin used in confirmation links.
PUBLIC_APP_ORIGIN=https://your-sessionboard-domain.example

# Cloudflare Worker secrets (set with `wrangler secret put`; never prefix with VITE_).
TURNSTILE_SECRET_KEY=replace-with-the-turnstile-widget-secret
CFP_EDGE_SECRET=replace-with-a-long-random-secret-shared-with-convex
CFP_RATE_LIMIT_KEY_SECRET=replace-with-a-long-random-hmac-secret

# Convex deployment environment (set with `npx convex env set`, not in this file's runtime).
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
# Also set the same `CFP_EDGE_SECRET` value in this Convex deployment.
# Per-event email provider credentials are encrypted with this key before storage, by the
# organizer-gated Convex actions in convex/emailIntegrationsActions.ts.
# Generate with: openssl rand -base64 32
EMAIL_INTEGRATION_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Content-source credentials use a separate AES-256-GCM key. Never reuse the email key.
CONTENT_INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-base64-32-byte-key
# Convex Site origin used to form OAuth callback URLs (server-only, no VITE_ prefix).
CONVEX_SITE_URL=https://your-project.convex.site
# Public OAuth apps registered with these exact Convex Site callback URLs:
# https://your-project.convex.site/oauth/notion/callback and /oauth/airtable/callback
NOTION_OAUTH_CLIENT_ID=your-notion-oauth-client-id
NOTION_OAUTH_CLIENT_SECRET=your-notion-oauth-client-secret
AIRTABLE_OAUTH_CLIENT_ID=your-airtable-oauth-client-id
AIRTABLE_OAUTH_CLIENT_SECRET=your-airtable-oauth-client-secret
# Operations Agent BYOK credentials use a separate AES-256-GCM key. Never reuse the email key.
AI_INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-base64-32-byte-key
# Server-only managed AI and Clerk Billing configuration (set in Convex, never Vite/browser env).
OPENAI_API_KEY=replace-with-namos-server-side-key
CLERK_SECRET_KEY=replace-with-clerk-server-secret
CLERK_AGENT_REQUIRED_FEATURE=agent-managed-ai
# JSON keyed by Clerk Billing plan slug. Values are monthly terms, not application constants.
CLERK_AGENT_PLAN_ALLOWANCES={"pro":{"runs":100,"tokens":1000000,"perRunTokens":20000}}
# Legacy: only the deprecated netlify/functions/email-integrations-*.mjs handlers use this.
EMAIL_INTEGRATION_SERVICE_SECRET=replace-with-a-long-random-secret

# DO NOT run `npx convex deploy` in this repo — it targets an unused, empty
# production slot.
#
# Deploy the backend with `npm run convex:deploy`, NOT a bare `npx convex dev --once`.
#
# Why: `convex dev` derives the deployment's CLERK_JWT_ISSUER_DOMAIN from
# VITE_CLERK_PUBLISHABLE_KEY. Dev and production currently share ONE Convex
# deployment, so a `pk_test_` key in a local env file silently repoints the
# production backend at a dev Clerk instance. Every authenticated write then
# fails identity verification and users hit a generic "cannot write to the
# database" error — invisible until someone tries to sign up. That is the
# 2026-08-16 onboarding outage; it recurred three times in one night.
#
# `npm run convex:deploy` runs the deploy and then re-asserts the correct
# issuer (scripts/check-convex-auth.mjs). `npm run convex:check-auth` verifies
# without deploying. `npm run deploy` refuses to ship if the issuer has drifted.
#
# The real fix is separate dev and production Convex deployments — see #223.
